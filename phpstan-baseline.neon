parameters:
	ignoreErrors:
		-
			message: '#^Anonymous function should return DateTimeInterface but returns DateTimeInterface\|null\.$#'
			identifier: return.type
			count: 1
			path: src/FormRequestMixin.php

		-
			message: '#^Anonymous function should return object but returns object\|null\.$#'
			identifier: return.type
			count: 1
			path: src/FormRequestMixin.php
